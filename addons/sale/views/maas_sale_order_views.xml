<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_maas_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.maas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="after">
                <field name="business_line" invisible="1"/>
                <field name="maas_product_type" invisible="1"/>
                <field name="maas_usage_only" invisible="1"/>
                <field name="maas_product_family_id" required="business_line == 'maas'" readonly="state in ['sale', 'cancel']"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">parent.maas_product_family_id and [('sale_business_line', '=', 'maas'), ('maas_product_family_id', '=', parent.maas_product_family_id)] or [('sale_business_line', '=', parent.business_line)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">parent.maas_product_family_id and [('sale_business_line', '=', 'maas'), ('maas_product_family_id', '=', parent.maas_product_family_id)] or [('sale_business_line', '=', parent.business_line)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form/field[@name='technical_price_unit']" position="after">
                <field name="product_template_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="maas_cache_mode" invisible="1"/>
                <field name="maas_price_card_id" string="Price Card Version" domain="[('product_tmpl_id', '=', product_template_id), ('state', '=', 'active'), ('active', '=', True)]" invisible="parent.business_line != 'maas'"/>
                <field name="maas_model_id" string="Upstream Model ID" readonly="1" invisible="parent.maas_product_type != 'model'"/>
                <field name="maas_input_rate" string="Input List Price / 1M Tokens" readonly="1" invisible="parent.maas_product_type != 'model' or not maas_price_card_id"/>
                <field name="maas_output_rate" string="Output List Price / 1M Tokens" readonly="1" invisible="parent.maas_product_type != 'model' or not maas_price_card_id"/>
                <field name="maas_cache_rate" string="Cache List Price / 1M Tokens" readonly="1" invisible="parent.maas_product_type != 'model' or maas_cache_mode != 'single'"/>
                <field name="maas_cache_read_rate" string="Cache Read List Price / 1M Tokens" readonly="1" invisible="parent.maas_product_type != 'model' or maas_cache_mode != 'read_write'"/>
                <field name="maas_cache_write_rate" string="Cache Write List Price / 1M Tokens" readonly="1" invisible="parent.maas_product_type != 'model' or maas_cache_mode != 'read_write'"/>
                <field name="maas_api_rate" string="API List Price" readonly="1" invisible="parent.maas_product_type != 'api' or not maas_price_card_id"/>
                <field name="maas_api_unit_name" string="API Rate Unit" readonly="1" invisible="parent.maas_product_type != 'api' or not maas_price_card_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//label[@for='product_uom_qty']" position="attributes">
                <attribute name="invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//div[@name='ordered_qty']" position="attributes">
                <attribute name="invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="attributes">
                <attribute name="invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='tax_ids']" position="attributes">
                <attribute name="invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//label[@for='discount']" position="attributes">
                <attribute name="invisible">parent.business_line != 'maas'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//div[@name='discount']" position="attributes">
                <attribute name="invisible">parent.business_line != 'maas'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='discount']" position="attributes">
                <attribute name="invisible">parent.business_line != 'maas'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//column[@name='product_and_description']/field[@name='product_id']" position="after">
                <field name="maas_model_id" string="Model ID" readonly="1" invisible="parent.maas_product_type != 'model'" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//column[@name='product_and_description']" position="after">
                <field name="maas_price_card_id" string="Card Version" domain="[('product_tmpl_id', '=', product_template_id), ('state', '=', 'active'), ('active', '=', True)]" column_invisible="parent.business_line != 'maas'" optional="show"/>
                <field name="maas_cache_mode" column_invisible="True"/>
                <field name="maas_input_rate" string="Input / 1M" invisible="not maas_price_card_id" column_invisible="parent.maas_product_type != 'model'" optional="show"/>
                <field name="maas_output_rate" string="Output / 1M" invisible="not maas_price_card_id" column_invisible="parent.maas_product_type != 'model'" optional="show"/>
                <field name="maas_cache_rate" string="Cache / 1M" invisible="not maas_price_card_id or maas_cache_mode != 'single'" column_invisible="parent.maas_product_type != 'model'" optional="show"/>
                <field name="maas_cache_read_rate" string="Cache Read / 1M" invisible="not maas_price_card_id or maas_cache_mode != 'read_write'" column_invisible="parent.maas_product_type != 'model'" optional="show"/>
                <field name="maas_cache_write_rate" string="Cache Write / 1M" invisible="not maas_price_card_id or maas_cache_mode != 'read_write'" column_invisible="parent.maas_product_type != 'model'" optional="show"/>
                <field name="maas_api_rate" string="API List Price" invisible="not maas_price_card_id" column_invisible="parent.maas_product_type != 'api'" optional="show"/>
                <field name="maas_api_unit_name" string="Rate Unit" invisible="not maas_price_card_id" column_invisible="parent.maas_product_type != 'api'" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//column[@name='sol_qty']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//column[@name='sol_uom']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//column[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list[@name='sol_list']//field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='discount']" position="attributes">
                <attribute name="string">Discount (%)</attribute>
                <attribute name="groups">sales_team.group_sale_salesman</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list[@name='sol_list']//field[@name='discount']" position="attributes">
                <attribute name="column_invisible">parent.business_line != 'maas'</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list[@name='sol_list']//field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list[@name='sol_list']//field[@name='price_total']" position="attributes">
                <attribute name="column_invisible">parent.maas_usage_only</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <div class="alert alert-info" role="status" invisible="not maas_usage_only">
                    This quotation lists the service catalog prices and discount. Charges are invoiced from recorded usage, so no fixed order total is shown.
                </div>
            </xpath>
            <xpath expr="//group[@name='sale_total']" position="attributes">
                <attribute name="invisible">maas_usage_only</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_maas_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.maas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="business_line" optional="hide"/>
                <field name="maas_usage_only" column_invisible="True"/>
            </field>
            <field name="amount_total" position="attributes">
                <attribute name="invisible">maas_usage_only</attribute>
            </field>
        </field>
    </record>

    <record id="sale_order_search_maas_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.maas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="business_line"/>
            </field>
            <filter name="salesperson" position="after">
                <filter name="business_line" string="Sales Business Line" context="{'group_by': 'business_line'}"/>
            </filter>
        </field>
    </record>
</odoo>
