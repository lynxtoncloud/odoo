<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_maas_channel_list" model="ir.ui.view">
        <field name="name">purchase.maas.channel.list</field>
        <field name="model">purchase.maas.channel</field>
        <field name="arch" type="xml">
            <list string="MaaS Supplier Channels">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="purchase_maas_channel_form" model="ir.ui.view">
        <field name="name">purchase.maas.channel.form</field>
        <field name="model">purchase.maas.channel</field>
        <field name="arch" type="xml">
            <form string="MaaS Supplier Channel">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="partner_id" domain="[('supplier_rank', '&gt;', 0)]"/>
                            <field name="name"/>
                            <field name="channel_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="note" placeholder="Internal notes"/>
                        </group>
                    </group>
                    <separator string="Supplier Model Offers"/>
                    <field name="offer_ids" context="{'default_channel_id': id}">
                        <list>
                            <field name="product_tmpl_id"/>
                            <field name="provider_model_name"/>
                            <field name="upstream_channel"/>
                            <field name="billing_mode"/>
                            <field name="state" widget="badge" decoration-success="state == 'active'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_maas_channel_action" model="ir.actions.act_window">
        <field name="name">MaaS Supplier Channels</field>
        <field name="res_model">purchase.maas.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="purchase_maas_offer_list" model="ir.ui.view">
        <field name="name">purchase.maas.offer.list</field>
        <field name="model">purchase.maas.offer</field>
        <field name="arch" type="xml">
            <list string="MaaS Supplier Pricing">
                <field name="partner_id"/>
                <field name="channel_id"/>
                <field name="channel_code" optional="hide"/>
                <field name="upstream_channel" optional="hide"/>
                <field name="product_tmpl_id"/>
                <field name="provider_model_name"/>
                <field name="billing_mode"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="input_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="output_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="cache_price_summary"/>
                <field name="per_call_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="supplier_discount"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="purchase_maas_offer_form" model="ir.ui.view">
        <field name="name">purchase.maas.offer.form</field>
        <field name="model">purchase.maas.offer</field>
        <field name="arch" type="xml">
            <form string="MaaS Supplier Pricing">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'" groups="purchase.group_purchase_manager"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state != 'active'" groups="purchase.group_purchase_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="product_tmpl_id" string="MaaS Product"/>
                        <h1><field name="product_tmpl_id"/></h1>
                    </div>
                    <group>
                        <group string="Supplier Route">
                            <field name="partner_id" readonly="1"/>
                            <field name="channel_id" domain="[('active', '=', True)]"/>
                            <field name="channel_code" readonly="1"/>
                            <field name="upstream_channel"/>
                            <field name="provider_model_name"/>
                        </group>
                        <group string="Purchase Terms">
                            <field name="billing_mode"/>
                            <field name="currency_id"/>
                            <field name="supplier_discount"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="cache_mode" invisible="billing_mode != 'tokens'"/>
                            <field name="tier_pricing_method"/>
                            <field name="note" placeholder="Internal notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase Pricing">
                            <div class="text-muted">Enter supplier published rates. Token prices are usually per million tokens. The supplier discount is tracked separately from the customer quotation discount.</div>
                            <group string="Standard Rates">
                                <field name="rate_ids" domain="[('pricing_role', '=', 'standard')]" context="{'default_pricing_role': 'standard'}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="metric"/>
                                        <field name="unit_name"/>
                                        <field name="quantity_divisor" optional="hide"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="active" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Time and Tier Rules">
                                <field name="rate_ids" domain="[('pricing_role', '=', 'rule')]" context="{'default_pricing_role': 'rule'}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="metric"/>
                                        <field name="unit_name"/>
                                        <field name="rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="use_time_window"/>
                                        <field name="time_from" widget="float_time" invisible="not use_time_window"/>
                                        <field name="time_to" widget="float_time" invisible="not use_time_window"/>
                                        <field name="timezone" invisible="not use_time_window" optional="hide"/>
                                        <field name="is_tiered"/>
                                        <field name="tier_basis" invisible="not is_tiered"/>
                                        <field name="min_quantity" invisible="not is_tiered"/>
                                        <field name="max_quantity" invisible="not is_tiered"/>
                                        <field name="date_start" optional="hide"/>
                                        <field name="date_end" optional="hide"/>
                                        <field name="active" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_maas_offer_action" model="ir.actions.act_window">
        <field name="name">MaaS Supplier Pricing</field>
        <field name="res_model">purchase.maas.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="product_template_form_maas_procurement_inherit" model="ir.ui.view">
        <field name="name">product.template.form.maas.procurement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MaaS Supplier Offers" name="maas_supplier_offers"
                    invisible="type != 'service' or not sale_ok" groups="purchase.group_purchase_user">
                    <field name="type" invisible="1"/>
                    <field name="sale_ok" invisible="1"/>
                    <field name="maas_procurement_offer_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                            <field name="channel_id"/>
                            <field name="channel_code" optional="hide"/>
                            <field name="upstream_channel" optional="hide"/>
                            <field name="provider_model_name"/>
                            <field name="billing_mode"/>
                            <field name="input_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="output_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cache_price_summary"/>
                            <field name="per_call_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="supplier_discount"/>
                            <field name="state" widget="badge" decoration-success="state == 'active'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_purchase_maas_channel" name="MaaS Supplier Channels"
        parent="purchase.menu_purchase_config" action="purchase_maas_channel_action"
        groups="purchase.group_purchase_manager" sequence="40"/>
    <menuitem id="menu_purchase_maas_offer" name="MaaS Supplier Pricing"
        parent="purchase.menu_purchase_config" action="purchase_maas_offer_action"
        groups="purchase.group_purchase_manager" sequence="41"/>
</odoo>
